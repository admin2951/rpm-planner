# 複製此檔為 .env 並填入實際值

# 資料庫（本機用 SQLite；日後部署到 Vercel + Supabase 時，
# 把 prisma/schema.prisma 的 datasource provider 改成 "postgresql"，
# url 改用 POSTGRES_PRISMA_URL，directUrl 改用 POSTGRES_URL_NON_POOLING）
DATABASE_URL="file:./dev.db"

# Session 加密金鑰（請用長隨機字串，可執行：openssl rand -base64 32）
SESSION_SECRET=""

# 個人帳號（唯一使用者，由 seed 建立）
ADMIN_EMAIL="admin@esheco.com"
ADMIN_PASSWORD=""

# 網站對外網址（未來部署後使用）
APP_URL="http://localhost:3000"
