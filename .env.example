# 複製此檔為 .env 並填入實際值

# 資料庫（Vercel 的 Supabase 整合會自動填入，本機開發用同一組 Postgres 連線）
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# Session 加密金鑰（請用長隨機字串，可執行：openssl rand -base64 32）
SESSION_SECRET=""

# 個人帳號（唯一使用者，由 seed 建立）
ADMIN_EMAIL="admin@esheco.com"
ADMIN_PASSWORD=""

# 網站對外網址（未來部署後使用）
APP_URL="http://localhost:3000"
