// RPM 系統 — 資料庫結構
// 部署於 Vercel + Supabase（PostgreSQL）。
// POSTGRES_PRISMA_URL：Supabase 提供的 pooled 連線（執行期查詢用）
// POSTGRES_URL_NON_POOLING：Supabase 提供的直連（migrate / db push 用）
// 兩者由 Vercel 的 Supabase 整合自動填入（本機開發用 .env.local 裡的同一組值）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ── 使用者（單人使用，僅由 seed 建立一個帳號）───────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

enum Priority {
  MUST
  SHOULD
  COULD
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum ResultStatus {
  ACTIVE
  DONE
  ARCHIVED
}

// ── RPM 條目：R（成果）+ P（理由）+ M（行動計畫，掛在底下的 Task）───
model Result {
  id String @id @default(cuid())

  title      String // R：具體、可衡量的成果
  purpose    String? // P：為什麼想要這個結果
  targetDate DateTime? // 時間：預計多久內完成

  status ResultStatus @default(ACTIVE)
  order  Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
}

// ── 行動項目：M 的每一步，或未掛任何 RPM 條目的瑣碎待辦事項 ─────
// resultId 為 null 時就是純粹的待辦事項（不屬於任何 RPM 條目）。
model Task {
  id       String  @id @default(cuid())
  resultId String?
  result   Result? @relation(fields: [resultId], references: [id], onDelete: SetNull)

  title       String // 內容
  notes       String? // 備註
  priority    Priority   @default(SHOULD)
  status      TaskStatus @default(TODO)
  dueDate     DateTime? // 截止日期
  completedAt DateTime?
  order       Int        @default(0)

  createdAt DateTime @default(now()) // 建立日期
  updatedAt DateTime @updatedAt

  @@index([resultId])
  @@index([status])
  @@index([dueDate])
}

// ── 每日反思／心得（一天一筆自由文字）─────────────────────
model DailyNote {
  id      String   @id @default(cuid())
  date    DateTime @unique
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
